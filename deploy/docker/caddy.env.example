# Names and FAKE values only. The real file lives on the server only
# (suggested /etc/food-orders/caddy.env, mode 600) and is never committed.
# Read by compose and passed to the caddy container (next card).

# Public hostnames (DNS must point at the VM). Defaults in the Caddyfile are
# local-only names, so leaving these unset never requests a public certificate.
CUSTOMER_HOST=customer.example.com
RESTAURANT_HOST=restaurant.example.com

# Shared access gate. Make the real hash with `caddy hash-password`.
# Single quotes keep the $ signs (check how compose reads the file: a `$` may
# need doubling there; the compose card decides).
FOOD_ORDERS_AUTH_USER=demo
FOOD_ORDERS_AUTH_HASH='$2a$14$REPLACE_ME'
