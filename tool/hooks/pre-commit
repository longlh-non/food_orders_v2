#!/usr/bin/env bash
# Opt-in pre-commit hook (enable with `make hooks-install`).
# Read-only: checks the *staged* version of each Dart file, never rewrites it.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
export PATH="$HOME/development/flutter/bin:$PATH"

staged_root="$(mktemp -d "${TMPDIR:-/tmp}/food-orders-staged.XXXXXX")"
trap 'rm -r -- "$staged_root"' EXIT

files=()
while IFS= read -r file; do
  [[ -n "$file" ]] || continue
  mkdir -p "$staged_root/$(dirname "$file")"
  git show ":$file" > "$staged_root/$file"
  files+=("$staged_root/$file")
done < <(git diff --cached --name-only --diff-filter=ACMR -- '*.dart')

if [[ ${#files[@]} -eq 0 ]]; then
  exit 0
fi

if ! dart format --output=none --set-exit-if-changed "${files[@]}" > /dev/null; then
  echo '[pre-commit] Some staged Dart files are not formatted. Run: dart format <files>, then git add them.' >&2
  exit 1
fi
echo '[pre-commit] format ok.'
